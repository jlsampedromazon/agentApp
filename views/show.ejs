<!DOCTYPE html>
<html lang="en">
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <title>DealPro | Dealtech Tool for Professional Dealmakers</title>

    <% include partials/boilerLinks.ejs %>

</head>

<body>

    <% include partials/navbar.ejs %>

    <div id="controlsOne">
        <a href="/records" class="ui grey button gridControl"><i class="fa fa-chevron-left"></i> &nbsp All Records</a>
        <a href="/records/<%= loi._id %>/update-terms" class="ui orange button gridControl"><i class="fa fa-edit"></i> &nbsp Edit LOI</a>
	</div>
	<div id="controlsTwo">
        <form id="requestPdf" class="gridControl" action="/records/<%= loi._id %>/generate-pdf" method="POST">
            <input id="hiddenTextPdf" type="text" value="<%= loi.fullText %>" name='opp[fullText]'>
            <button id="btnDowload" class="ui red button btnControl"><i class="fa fa-download"></i> &nbsp Get PDF</button>
        </form>
		<form id="requestEsig" class="gridControl" action="/records/<%= loi._id %>/esigndetails" method="POST">
            <input id="hiddenTextEsig" type="text" value="<%= loi.fullText %>" name='opp[fullText]'>
            <button id="btnEsig" class="ui black button btnControl"><i class="fa fa-file-signature"></i> &nbsp eSign Letter</button>
        </form>
    </div>

    <div class="ui main text container segment" id="showWindow">
        <%- loi.fullText %>
    </div>  

    <% include partials/boilerScripts.ejs %>

</body>

</html>