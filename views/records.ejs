<!DOCTYPE html>
<html lang="en">
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <title>LeaseAgreement.SG for Agents</title>

    <% include partials/boilerLinks.ejs %>

</head>

<body>

    <% include partials/navbar.ejs %>
	<div id="recordsHead">
			<img id="agentPhoto" src="<%- foundAgent.image %>">
			<div id="agentWelcome">
				<h3 id="agentGreet">Welcome to DealPro,</h3>
				<h1 id="agentName">M. <%= foundAgent.fullName %></h1>
			</div>

	</div>

    <div id="mainRecordsDiv" class="ui main text container mainDiv">
            <h5>This is your Dashboard. Click or tap on the boxes below to view each LOI.</h5>
		<p>
			<pre><i class="fa fa-user"> </i> Tenant Name 	<i class="fa fa-money-bill-wave"> </i> Monthly Rent</pre>
		</p>
        
        <% if (lois.length > 0) {lois.forEach(function(loi){ %>
    
            <div class="ui segment container record" onclick="divClick('<%= loi._id %>')">
                <h3><i class="fa fa-home"></i> <%= loi.address %></h3>
                
                <table id="keyInfo">
                    <colgroup>
                        <col width="70%">
                        <col width="30%">    
                    </colgroup>
                    <tbody>
                        <tr>
                            <td class="tenantInfo"><h5><i class="fa fa-user"></i> <%= loi.tenantName %></h5></td>
                            <td class="rentInfo"><p><i class="fa fa-money-bill-wave"> </i> <%- numFormat(loi.rentAmount) %></p></td>
                        </tr>
                    </tbody>
                </table>            
            </div>

        <% })} else { %>
            <div id="noneYet" class="ui segment container">
                <h3>You have not created any LOIs yet.</h3> 
                <h3>Click "New LOI" above to get started.</h3>
            </div>
       <% } %>

    </div>

    <% include partials/boilerScripts.ejs %>

    <script>
        
        function divClick(i) {
            location.href = "/records/"+i;
        }
        
    </script>

</body>

</html>