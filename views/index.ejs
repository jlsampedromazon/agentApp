<!DOCTYPE html>
<html lang="en">

<head>


	<!-- Metatags -->
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<meta http-equiv="X-UA-Compatible" content="ie=edge">

	<title>DealPro | Dealtech Tools for Professional Dealmakers</title>

	<meta property="og:title" content="DealPro | Dealtech for Professional Dealmakers">
	<meta property="og:description"
		content="Professional photographers don't use Paint. Are you still using using Word and Outlook to close  deals? DealPro is a professional tool designed by dealmakers for dealmakers to help you make better, faster and smarter deals.">
	<meta property="og:image" content="/img/dealproLogo.png">
	<meta property="og:url" content="https://www.dealpro.io/">

	<link rel="icon" href="/img/dealproFlavicon.ico">

	<!-- Boilerplate Links -->

	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.11.2/css/all.min.css"
		integrity="sha256-+N4/V/SbAFiW1MPBCXnfnP9QSN3+Keu+NlB+0ev/YKQ=" crossorigin="anonymous" />
	<link href="https://fonts.googleapis.com/css?family=Audiowide&display=swap" rel="stylesheet">
	<link rel="stylesheet" type="text/css" href="/css/bootstrap.min.css">
	<link rel="stylesheet" type="text/css" href="/css/index.css">
	<link href="https://fonts.googleapis.com/css?family=Lato&display=swap" rel="stylesheet">



</head>

<body>

	<div id="pageHead">

		<div id="headerContent" class="container-fluid">
			<h1 class="audiowide"> DealPro&trade;</h1>
			<h3>Deal Technology for Professional Dealmakers.</h3>
		</div>

	</div>

	<div id="betaOne">
		<div id="betaContent">
			<p id="betaLead">Private Beta for Real Estate Available Now!</p>
			<p class="betaRegister"> If you already have a DealPro Account</p>
			<a id="btnLogin" class="btn btn-primary" href="/login">Log-In</a>
			<p class="betaRegister">Don’t have an account with us yet?</p>
			<a id="btnRegister" class="btn btn-success" href="/join">Request to Join!</a>
			<p class="betaRegister">to participate in our private beta!</p>
		</div>
	</div>

	<div id="quote" class="container">
		<div id="quoteContent">
			<h5 id="topQuote">Photographers do not use Paint.</h5>
			<h5>You deserve better than Word &amp; Outlook to close deals.</h5>
		</div>
	</div>

	<div id="featureSection" class="row container">
		<div class="col-6">
			<img src="/img/generateOne.svg">
			<p>
				Auto-generate deal docs in seconds
			</p>
		</div>
		<div class="col-6">
			<img src="/img/update.svg">
			<p>
				Update &amp; edit contracts on-the-go
			</p>
		</div>
		<div class="col-6">
			<img src="/img/eSig.svg">
			<p>
				Collaborate &amp; eSign deals seamlessly
			</p>
		</div>
		<div class="col-6">
			<img src="/img/download.svg">
			<p>
				Store docs safely on cloud to retrieve anytime
			</p>
		</div>
		<div class="col-6">
			<img src="/img/mobileFirst.svg">
			<p>
				Mobile-first design goes wherever you go
			</p>
		</div>
		<div class="col-6">
			<img src="/img/lifecycle.svg">
			<p>
				End-to-end deal lifecycle management
			</p>
		</div>

	</div>

	<div id="mission" class="container">
		<div id="missionContent">

			<h5>"DealPro is an all-in-one app designed for professional dealmakers to make transactions easier, faster,
				smarter and more cost efficient than ever using the latest technology."</h5>
			<img id="founderPhoto" src="/img/me-photo-red.jpg">
			<p class="quoteSource">
				&mdash; <a target=”_blank” href="https://www.linkedin.com/in/jlsampedromazon/">Jose Sampedro,
					Founder</a>
			</p>
		</div>
	</div>
	<div id="lexknightsBanner" class="container-fluid">
		<div id="lexknightsBannerContent">
			<h2 id='power'>Powered by LexKnights&trade;</h2>
			<img id='salLogos' src="/img/logosSAL2-red.png" alt="Singapore Academy of Law Logos">
		</div>
	</div>

	<div id="footer">

		<div id="legal" class="container">

			<div id="legalContent">

				<h5>Interested in DealPro?</h5>
				<p> Provide your name &amp; address and we will reach out with more information!</p>

				<form id="interestedForm" class="form-inline" action="/join" method="POST">
					<select name="salutation" class="form-control mb-2 mr-sm-2" required>
						<option value="Mr.">Mr.</option>
						<option value="Ms.">Ms.</option>
					</select>
					<input class="form-control mb-2 mr-sm-2" type="text" placeholder="Full Name" name="fullName"
						required>
					<input class="form-control mb-2 mr-sm-2" type="text" placeholder="Email Address" name="username"
						required>
					<button type="submit" class="btn btn-outline-light mb-2">Submit</button>
				</form>

				<p>This service is provided by Lexknights Pte Ltd (Reg. No. 201917412C), a technology company registered
					in Singapore.</p>

				<p>By login-in, you accept our Terms of Use &amp Privacy Policy, acessible via the links below.</p>

				<p><a href="/privacy">Terms of Use</a> | <a href="/terms">Privacy Policy</a></p>

				<p>Copyright &copy 2019 by LexKnights. All rights reserved.</p>

			</div>
		</div>
	</div>

	<!-- Include other joiner form values -->
	<script>
		$("#newForm").submit(function (event) {

			$(this).append('<input type="hidden" name="company" value="empty"/>');
			$(this).append('<input type="hidden" name="mobile" value="0"/>');
			$(this).append('<input type="hidden" name="regNo" value="empty"/>');

		});
	</script>
</body>

</html>