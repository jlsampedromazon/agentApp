<!DOCTYPE html>
<html lang="en">
    <!DOCTYPE html>
    <html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <meta http-equiv="X-UA-Compatible" content="ie=edge">
        <title>DealPro | Dealtech for Professional Dealmakers</title>
    
        <% include partials/boilerLinks.ejs %>
        
        <link rel="stylesheet" href="/css/calendar.min.css">


    </head>
    <body>
    
        <% include partials/navbar.ejs %>

    <div id="termsWrap" class="ui main text container segment">
        
        <div class="ui huge header"><i class="fa fa-edit" aria-hidden="true"></i> Update LOI</div>

        <form id="updateForm" class="ui form" action="/records/<%= loi._id %>/update-terms?_method=PUT" method="POST" onsubmit="showLoading()">

            <!-- Property Address -->

            <div class="field">
                <label for="opp[address]">Property Address:</label>
                <input type="text" value="<%= loi.address %>" name="opp[address]" required>
            </div>

            <!-- Landlord Name -->

            <div class="field">
                <label for="opp[landlordName]">Landlord's Name:</label>
                <input type="text" value="<%= loi.landlordName %>" name="opp[landlordName]" required>
            </div>

            <!-- Landlord ID -->

            <div class="field">
                <label for="opp[landlordId]">Landlord's ID Number:</label>
                <input type="text" value="<%= loi.landlordId %>" name="opp[landlordId]" required>
            </div>

            <!-- Tenant Name -->

            <div class="field">
                <label for="opp[tenantName]">Tenant's Name:</label>
                <input type="text" value="<%= loi.tenantName %>" name="opp[tenantName]" required>
            </div>

            <!-- Tenant ID -->

            <div class="field">
                <label for="opp[tenantId]">Tenant's ID Number:</label>
                <input type="text" value="<%= loi.tenantId %>" name="opp[tenantId]" required>
            </div>
            
            <!--Monthly Rent  -->
            
            <div class="field">
                <label for="opp[rentAmount]">Monthly Rent (S$):</label>
                <input type="number" value="<%= loi.rentAmount %>" name="opp[rentAmount]" required>
            </div>
                        
            <!--Bank Name  -->
            
            <div class="field">
                    <label for="opp[bank]">Landlord's Bank Name:</label>
                    <input type="text" value="<%= loi.bank %>" name="opp[bank]" required>
            </div>
                        
            <!--Bank Account  -->
            
            <div class="field">
                    <label for="opp[account]">Landlord's Bank Acct. No.:</label>
                    <input type="text" value="<%= loi.account %>" name="opp[account]" required>
                </div>    
                
            <!-- Lease Period -->
            
            <div class="field">
                <label for="opp[leasePeriod]">Period of Lease (in months):</label>
                <input type="number" value="<%= loi.leasePeriod %>" name="opp[leasePeriod]" required>
            </div>
            
            <!-- Start Date -->
            
            <div class="field">
                    <label for="opp[startDate]"><i class="fa fa-calendar"></i>  Lease Start Date:</label>
                    <div class="ui calendar" id="ical2">
                            <div class="ui input icon ">
                              <input type="text" value="<%= moment(loi.startDate).format('Do MMMM YYYY') %>" name="opp[startDate]" required>
                            </div>
                    </div>
            </div>
    
            <!-- Diplomatic Clause -->

            <div class="ui segment">
                <div class="field">
                  <div class="ui toggle checkbox">
                    <input id="updateDiplo" type="checkbox" name="opp[diplo]" value="yes">
                    <label>Diplomatic Clause</label>
                  </div>
                </div>
            </div>

            <div id="submitDiv">

                <button id="btnSubmitNew" class="ui primary button big" type="submit"><i id="submitSpinner" class="fas fa-spinner fa-spin"></i> &nbsp; Submit</button>

            </div>
            
        </form>
    
    </div>

    <!-- Boostrap, JQuery & Custom Scripts -->

    <% include partials/boilerScripts.ejs %>

    <script type="text/javascript" src="/js/calendar.js"></script>
    <script>
    $('#ical2').calendar({type: 'date'});

    // Reflect current diplo status
    if ("<%= loi.diplo %>" == "yes") {
        $("#updateDiplo").prop('checked', true);
    }

    // Change diplo status where initial val = yes, then changed to no
    $( "#updateForm" ).submit(function(event) {
        
        $(window).off('beforeunload');

        if ($("#updateDiplo").prop('checked') === false) {
            $(this).append('<input type="hidden" name="opp[diplo]" value="no">');
        }

    }); 

    $(window).on('beforeunload', function(){
      return 'Are you sure you want to leave? Any changes made will be lost!';
    });

    </script>

<script>
        function showLoading() {
            $("#submitSpinner").css("display","inline-block");
        }
    </script>

</body>
</html>