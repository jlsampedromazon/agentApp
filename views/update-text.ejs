<!DOCTYPE html>
<html lang="en">
    <!DOCTYPE html>
    <html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <meta http-equiv="X-UA-Compatible" content="ie=edge">
        <title>LeaseAgreement.SG for Agents</title>
    
        <% include partials/boilerLinks.ejs %>

        <script src="https://cdn.tiny.cloud/1/tcu7wzuijq2kr1cmlp0pzf3o79z4k3qap72crqx8yzfbwc78/tinymce/5/tinymce.min.js"></script>

        <script>
            tinymce.init({
            selector: 'textarea',
            height: '100vh',
            theme: 'silver',
            plugins:  'autosave lists autolink save',
            mobile: {
                theme: 'mobile',
                plugins:  'autosave lists autolink save' 
            }
        
            });
        </script>

    </head>
    <body>
    
        <% include partials/navbar.ejs %>

        <form id="updateTextForm" action="/records/<%= loi.id %>?_method=PUT" method="POST">
            <button class="ui green button btnFinalize"><i class="fa fa-check"></i> &nbsp Finalize &amp; Save</button>
            <textarea name='opp[fullText]'>
                <%= loi.fullText %>
            </textarea>
            <button class="ui green button btnFinalize"><i class="fa fa-check"></i> &nbsp Finalize &amp; Save</button>
        </form>
        
        <% include partials/boilerScripts.ejs %>

        <script>
        
        $(window).on('beforeunload', function(){
            return 'Please click the "Finalize & Save" button before leaving this page. Otherwise the file will not be usable.';
        });

        $( "#updateTextForm" ).submit(function(event) {
            $(window).off('beforeunload');
        })
        
        </script>
    </body>
</html>