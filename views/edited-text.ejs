<!DOCTYPE html>
<html lang="en">
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <title>DealPro | Dealtech for Professional Dealmakers</title>

    <% include partials/boilerLinks.ejs %>

</head>

<body>

    <% include partials/navbar.ejs %>

    <div id="controlsOne">
        <form id="saveText" class="gridControl" action="/records/<%= loi.id %>?_method=PUT" method="POST">
            <input id="hiddenTextSave" type="text" name='opp[fullText]'>
            <button id="btnSubmitSave" class="ui green button btnControl" onclick="showLoading(this)" data-id="#submitSaveSpinner"><i id="submitSaveSpinner" class="fas fa-spinner fa-spin"></i> &nbsp; <i class="fa fa-save"></i> &nbsp Save Changes</button>
        </form>
        <form id="editText" class="gridControl" action="/records/<%= loi.id %>/update-text?_method=PUT" method="POST">
            <input id="hiddenTextEdit" type="text" name='opp[fullText]'>
            <button id="btnSubmitEdit" class="ui orange button btnControl" onclick="showLoading(this)" data-id="#submitEditSpinner"><i id="submitEditSpinner" class="fas fa-spinner fa-spin"></i> &nbsp; <i class="fa fa-edit"></i> &nbsp Edit Text</button>
        </form>
	</div>
	<div id="controlsTwo">
        <form id="requestPdf" class="gridControl" action="/records/<%= loi._id %>/generate-pdf" method="POST">
            <input id="hiddenTextPdf" type="text" name='opp[fullText]'>
            <button id="btnSubmitPdf" class="ui red button btnControl"><i class="fa fa-download"></i> &nbsp Get PDF</button>
        </form>
		<form id="requestEsig" class="gridControl" action="/records/<%= loi._id %>/esigndetails" method="POST">
            <input id="hiddenTextEsig" type="text" value="<%= loi.fullText %>" name='opp[fullText]'>
            <button id="btnEsig" class="ui black button btnControl" onclick="showLoading(this)" data-id="#submitEsigSpinner"><i id="submitEsigSpinner" class="fas fa-spinner fa-spin"></i> &nbsp; <i class="fa fa-file-signature"></i> &nbsp eSign Letter</button>
        </form>
    </div>

    <div class="ui main text container segment" id="showWindow">
        <%- loi.fullText %>
    </div>  

    <% include partials/boilerScripts.ejs %>

    <script>

            // Pass new values from terms update form


                $(".spanLandlordName").text("<%= loi.landlordName %>");
                $(".spanLandlordId").text("<%= loi.landlordId %>");
                $(".spanTenantName").text("<%= loi.tenantName %>");
                $(".spanTenantId").text("<%= loi.tenantId %>");
                $(".spanAddress").text("<%= loi.address %>");
                $(".spanRentAmount").html('<span style="text-transform: uppercase"><%- numConverter.toWords(loi.rentAmount) %></span> ONLY (<%- numFormat(loi.rentAmount) %>)');
                $(".spanLeasePeriod").html('<span style="text-transform: uppercase"><%- numConverter.toWords(loi.leasePeriod) %></span> (<%= loi.leasePeriod %>)');
                $("#spanBank").text("<%= loi.bank %>");
                $("#spanAccount").text("<%= loi.account %>");
                $(".spanStartDate").text("<%= moment(loi.startDate).format('Do MMMM YYYY') %>");
                
                if ($("#spanDiplo").text() == "" && "<%= loi.diplo %>" == "yes") {
                    $("#spanDiplo").html("The Diplomatic clause shall be applicable after <strong>TWELVE (12) months</strong> of occupation by the Tenant giving <strong>TWO (2) months</strong> notice or TWO (2) months rent in lieu of notice.");
                } else if ($("#spanDiplo").text() != "" && "<%= loi.diplo %>" == "no") {
                    $("#spanDiplo").html("");
                }

            
            // Prep HTML for PDF
            
            var htmlInput = $("#showWindow").html();
            $("#hiddenTextPdf").val(htmlInput);
            $("#hiddenTextSave").val(htmlInput);

            $(window).on('beforeunload', function(){
                return 'Please click the "Save Changes" button before leaving this page. Otherwise the file will not be usable.';
            });

            $( "#saveText" ).submit(function(event) {
                noAlert();
            })

            $( "#requestPdf" ).submit(function(event) {
                noAlert();
            })

            $( "#editText" ).submit(function(event) {
                noAlert();
            })

            function noAlert() {
                $(window).off('beforeunload');
            }


            var dataToSubmit = {fullText:htmlInput};
            $.ajax({
                url: "/records/<%= loi._id %>/savetext",
                type: 'PUT',
                data: dataToSubmit,
                success: function(result) {
                    console.log('Text Saved: '+ result)
                }
            });

    </script>

<script>
        function showLoading(btnID) {
            var spinName = $(btnID).attr("data-id");
            $(spinName).css("display","inline-block");
        }
    </script>

</body>

</html>