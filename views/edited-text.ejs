<!DOCTYPE html>
<html lang="en">
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <title>LeaseAgreement.SG for Agents</title>

    <% include partials/boilerLinks.ejs %>

</head>

<body>

    <% include partials/navbar.ejs %>

    <div id="showButtons">
        <a id='linkRecords' href="#" class="ui black button showButton"><i class="fa fa-chevron-left"></i> &nbsp All Records</a>
        <a id="linkEdit" href="#" class="ui orange button showButton"><i class="fa fa-edit"></i> &nbsp Edit Text</a>
        <form id="requestPdf" action="/generate-pdf" method="POST">
            <input id="hiddenText" type="text" name='opp[fullText]'>
            <button id="btnSubmit" class="ui red button" disabled><i class="fa fa-download"></i> &nbsp Download PDF</button>
        </form>
    </div>

    <div class="ui main text container segment" id="showWindow">
        <%- loi.fullText %>
    </div>  

    <% include partials/boilerScripts.ejs %>

    <script>

            // Pass new values from terms update form
                $(".spanLandlordName").text("<%= loi.landlordName %>");
                $(".spanLandlordId").text("<%= loi.landlordId %>");
                $(".spanTenantName").text("<%= loi.tenantName %>");
                $(".spanTenantId").text("<%= loi.tenantId %>");
                $(".spanAddress").text("<%= loi.address %>");
                $(".spanRentAmount").html('<span style="text-transform: uppercase"><%- numConverter.toWords(loi.rentAmount) %></span> ONLY (<%- numFormat(loi.rentAmount) %>)');
                $(".spanLeasePeriod").html('<span style="text-transform: uppercase"><%- numConverter.toWords(loi.leasePeriod) %></span> (<%= loi.leasePeriod %>)');
                $("#spanBank").text("<%= loi.bank %>");
                $("#spanAccount").text("<%= loi.account %>");
                $(".spanStartDate").text("<%= moment(loi.startDate).format('Do MMMM YYYY') %>");
                
                if ($("#spanDiplo").text() == "" && "<%= loi.diplo %>" == "yes") {
                    $("#spanDiplo").html("The Diplomatic clause shall be applicable after <strong>TWELVE (12) months</strong> of occupation by the Tenant giving <strong>TWO (2) months</strong> notice or TWO (2) months rent in lieu of notice.");
                } else if ($("#spanDiplo").text() != "" && "<%= loi.diplo %>" == "yes") {
                    $("#spanDiplo").html("");
                }

            // Save fullText with new values from terms update form
                var htmlInput   = $("#showWindow").html(),
                    data        = {opp:{fullText: htmlInput}},
                    url         = "/records/" + "<%= loi._id %>";

                $.ajax({
                    url: url, 
                    type: "PUT",
                    data: data,
                    success: function() {console.log("AJAX put performed!");}
                });

            // Prep HTML for PDF
                
                $("#hiddenText").val(htmlInput);
                $("#btnSubmit").removeAttr("disabled");
                $("#linkRecords").attr("href", "/records");
                $("#linkEdit").attr("href", "/records/<%= loi._id %>/update-text");

    </script>

</body>

</html>