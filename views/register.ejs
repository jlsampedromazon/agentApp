<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <meta http-equiv="X-UA-Compatible" content="ie=edge">
        <title>LeaseAgreement.SG for Agents</title>
    
        <% include partials/boilerLinks.ejs %>
    
    </head>
    
    <body style="background-color: #273755">
    
        <% include partials/navbar.ejs %>

        <div id="loginLogo" class="audiowide"> DealPro </div>
        <div id="loginByLexknights" class="audiowide">by LexKnights</div>

            <div class="ui main text container segment">
            
                    <div class="ui huge header"><i class="fa fa-user-plus" aria-hidden="true"></i> Register</div>
            
                        <form id="registerForm" class="ui form" action="/register" method="POST">
                
                            <!-- Input: fullName -->
                
                            <div class="field">
                                <label for="fullName">Full Name:</label>
                                <input type="text" placeholder="Enter your Full Name..." name="fullName" required>
                            </div>
                                    
                            <!-- Input: company -->
                
                            <div class="field">
                                <label for="company">Company:</label>
                                <input type="text" placeholder="Enter the name of your company..." name="company" required>
                            </div>
                
                            <!-- Input: username -->
                
                            <div class="field">
                                <label for="username">Username:</label>
                                <input type="email" placeholder="Enter your Username..." name="username" required>
                            </div>
                                    
                            <!-- Input: password -->
                
                            <div class="field">
                                <label for="password">Password:</label>
                                <input type="password" placeholder="Enter your Password..." name="password" required>
                            </div>

                            <!-- Submit Button -->

                            <div id="submitDiv">

                                    <input id="btnSubmitNew" class="ui button big" type="submit">
                    
                            </div>

                        </form>
                    </div>
            </div>

        <% include partials/boilerScripts.ejs %>

    </body>
</html>