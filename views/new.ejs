<!DOCTYPE html>
<html lang="en">
    <!DOCTYPE html>
    <html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <meta http-equiv="X-UA-Compatible" content="ie=edge">
        <title>LeaseAgreement.SG for Agents</title>
    
        <link href="https://stackpath.bootstrapcdn.com/font-awesome/4.7.0/css/font-awesome.min.css" rel="stylesheet" integrity="sha384-wvfXpqpZZVQGK6TAh5PVlGOfQNHSoD2xbE+QkPxCAFlNEevoEH3Sl0sibVcOQVnN" crossorigin="anonymous">
        <link href="https://fonts.googleapis.com/css?family=Audiowide&display=swap" rel="stylesheet">
        <link rel="stylesheet" type="text/css" href="css/semantic.min.css">
        <link rel="stylesheet" href="/css/custom.css">

    </head>
    <body>
    
        <!-- Navbar by Semantic UI -->
        <div class="ui fixed inverted menu">
            <div class="container ui">
                <div class="header item">
                    LexKnights
                </div>
            <a href="#" class="item">Records</a>;
            <a href="#" class="item">New LOI</a>
            </div>
        </div>
        

    <div class="ui main text container segment">
        
        <div class="ui huge header"><i class="fa fa-edit" aria-hidden="true"></i> New LOI</div>

        <form class="ui form" action="/edit" method="POST">


            <!-- Property Address -->

            <div class="field">
                <label for="opp[address]">Property Address:</label>
                <input type="text" placeholder="Enter address..." name="opp[address]">
            </div>

            <!-- Landlord Name -->

            <div class="field">
                <label for="opp[landlordName]">Landlord's Name:</label>
                <input type="text" placeholder="Enter full name..." name="opp[landlordName]">
            </div>

            <!-- Landlord ID -->

            <div class="field">
                <label for="opp[landlordId]">Landlord's ID Number:</label>
                <input type="text" placeholder="Enter Passport, FIN or NRIC..." name="opp[landlordId]">
            </div>

            <!-- Tenant Name -->

            <div class="field">
                <label for="opp[tenantName]">Tenant's Name:</label>
                <input type="text" placeholder="Enter full name..." name="opp[tenantName]">
            </div>

            <!-- Tenant ID -->

            <div class="field">
                <label for="opp[tenantID]">Tenant's ID Number:</label>
                <input type="text" placeholder="Enter Passport, FIN or NRIC..." name="opp[tenantID]">
            </div>
            
            <!--Monthly Rent  -->
            
            <div class="field">
                <label for="opp[rentAmount]">Monthly Rent (S$):</label>
                <input type="text" placeholder="Enter number only..." name="opp[rentAmount]">
            </div>
            
            <!-- Lease Period -->
            
            <div class="field">
                <label for="opp[period]">Period of Lease (in months):</label>
                <input type="text" placeholder="Enter lease duration..." name="opp[period]">
            </div>

            <!-- Diplomatic Clause -->

            <div class="ui segment">
                <div class="field">
                  <div class="ui toggle checkbox">
                    <input type="checkbox" name="opp[diplo]" value="includeDiplo">
                    <label>Diplomatic Clause</label>
                  </div>
                </div>
            </div>

            <div id="submitDiv">

                <input class="ui violet basic button big" type="submit">

            </div>
            
        </form>
    
    </div>

    <!-- Boostrap, JQuery & Custom Scripts -->
    <script src="js/jquery-3.4.1.min.js"></script>
    <script src="js/semantic.min.js"></script>
    <script src="js/custom.js"></script>
</body>
</html>